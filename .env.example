# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database (Supabase or Vercel Postgres)
DATABASE_URL=your_database_url_here

# App URL (for Telegram webhook)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Telegram Mini App
NEXT_PUBLIC_TG_BOT_USERNAME=cardsofmagic_bot

# Support Bot
SUPPORT_BOT_TOKEN=your_support_bot_token
SUPPORT_ADMIN_CHAT_ID=your_admin_chat_id

# Admin Panel Secret (required for /admin web panel access)
ADMIN_SECRET=generate_a_random_secret_here
