generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  telegramId      BigInt    @unique
  username        String?
  firstName       String?
  locale          String    @default("ru") // "ru" | "uk" | "en"
  birthDate       DateTime?
  zodiacSign      String?
  gender          String?   // "female" | "male" | "neutral" — used to address the user in the right grammatical gender
  localeManual    Boolean   @default(false) // true once the user picks a language by hand — stops auto-detection from overwriting it
  displayName     String?   // name the user chose for readings (falls back to Telegram firstName)
  isAdmin         Boolean   @default(false)
  mana            Int       @default(0)
  channelSubBonus Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  readings        Reading[]
  subscription    Subscription?
  referrals       Referral[]     @relation("referrer")
  referredBy      Referral?      @relation("referred")
  cardCollection  CardCollection[]
  payments        Payment[]
  streakDays      Int       @default(0)
  lastStreakDate  DateTime?
  freeReadsToday  Int       @default(0)
  freeReadsReset  DateTime  @default(now())
  bonusReads      Int       @default(0)

  // Economy / premium (2026-09 night pass)
  premiumSaved        Int       @default(0)   // oracles premium has saved this user (shown in profile)
  premiumBigReportAt  DateTime?               // last natal/matrix report taken for free on premium (1 per 30 days)
  firstReadingFree    Boolean   @default(false) // true for new users until their first paid reading is free
  source              String?                 // acquisition source from the start param (e.g. "tt_top3")
  achievementsClaimed String[]  @default([])  // achievement ids whose reward was already credited
  deckId              String    @default("classic") // active deck: its art is used in readings (src/data/decks.ts)

  @@index([telegramId])
}

// ─── Readings ────────────────────────────────────────────────────────────────

model Reading {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  type        ReadingType
  question    String?
  cards       Json
  interpretation String   @db.Text
  locale      String      @default("ru")
  manaCost    Int         @default(0)
  isPaid      Boolean     @default(false)
  createdAt   DateTime    @default(now())

  partnerName String?
  partnerSign String?

  followupCount   Int       @default(0)
  reminderSentAt  DateTime?

  @@index([userId, createdAt])
}

enum ReadingType {
  CARD_OF_DAY
  YES_NO
  PAST_PRESENT_FUTURE
  RELATIONSHIP
  WHAT_THEY_THINK
  CAREER_MONEY
  CELTIC_CROSS
  WEEKLY
  MONTHLY
  BIRTHDAY
  FREE_QUESTION
  COMPATIBILITY
  NUMEROLOGY
  RUNES
  DREAM
  PAST_LIVES
  CHAKRA
  ANGEL_NUMBERS
  MOON_PHASE
  PSYCH_PORTRAIT
  HOROSCOPE
  NATAL_CHART
  DESTINY_MATRIX
}

// ─── Subscriptions ───────────────────────────────────────────────────────────

model Subscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan
  status    SubStatus        @default(ACTIVE)
  starsTxId String?
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([userId, status])
}

enum SubscriptionPlan {
  BASIC
  PREMIUM
  VIP
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(cuid())
  telegramId    BigInt
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  starsAmount   Int
  manaAmount    Int      @default(0)
  itemType      String   // "mana_pack", "subscription", "reading"
  itemId        String?
  telegramPayId String?  @unique
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@index([telegramId])
}

// ─── Premium gifts ───────────────────────────────────────────────────────────
// Bought by one user, redeemed once by another via t.me/<bot>?start=gift_<code>

model PremiumGift {
  id              String    @id @default(cuid())
  code            String    @unique
  planId          String
  days            Int
  buyerTelegramId BigInt
  chargeId        String    @unique
  redeemedByTelegramId BigInt?
  redeemedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([buyerTelegramId])
}

// ─── Referrals ───────────────────────────────────────────────────────────────

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation("referrer", fields: [referrerId], references: [id])
  referredId  String   @unique
  referred    User     @relation("referred", fields: [referredId], references: [id])
  bonusGiven  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─── Rate Limiting (DB-backed for serverless) ────────────────────────────────

model RateLimit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ─── Card Collection ─────────────────────────────────────────────────────────

model CardCollection {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deckId     String   @default("classic") // each deck is collected separately
  cardId     Int
  timesDrawn Int      @default(1)          // "выпадала N раз" in the card sheet
  unlockedAt DateTime @default(now())

  @@unique([userId, deckId, cardId])
  @@index([userId])
}
