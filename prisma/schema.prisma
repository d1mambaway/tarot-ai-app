generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  telegramId      BigInt    @unique
  username        String?
  firstName       String?
  locale          String    @default("ru") // "ru" | "uk" | "en"
  birthDate       DateTime?
  zodiacSign      String?
  isAdmin         Boolean   @default(false)
  mana            Int       @default(0)
  channelSubBonus Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  readings        Reading[]
  subscription    Subscription?
  referrals       Referral[]     @relation("referrer")
  referredBy      Referral?      @relation("referred")
  cardCollection  CardCollection[]
  payments        Payment[]
  streakDays      Int       @default(0)
  lastStreakDate  DateTime?
  freeReadsToday  Int       @default(0)
  freeReadsReset  DateTime  @default(now())
  bonusReads      Int       @default(0)

  @@index([telegramId])
}

// ─── Readings ────────────────────────────────────────────────────────────────

model Reading {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  type        ReadingType
  question    String?
  cards       Json
  interpretation String   @db.Text
  locale      String      @default("ru")
  manaCost    Int         @default(0)
  isPaid      Boolean     @default(false)
  status      String      @default("complete") // "pending" | "complete" | "failed"
  createdAt   DateTime    @default(now())

  partnerName String?
  partnerSign String?

  natalBirthDate String?
  natalBirthTime String?
  natalBirthCity String?

  @@index([userId, createdAt])
}

enum ReadingType {
  CARD_OF_DAY
  YES_NO
  PAST_PRESENT_FUTURE
  RELATIONSHIP
  WHAT_THEY_THINK
  CAREER_MONEY
  CELTIC_CROSS
  WEEKLY
  MONTHLY
  BIRTHDAY
  FREE_QUESTION
  COMPATIBILITY
  NUMEROLOGY
  RUNES
  DREAM
  PAST_LIVES
  CHAKRA
  ANGEL_NUMBERS
  MOON_PHASE
  PSYCH_PORTRAIT
  HOROSCOPE
  NATAL_CHART
}

// ─── Subscriptions ───────────────────────────────────────────────────────────

model Subscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan
  status    SubStatus        @default(ACTIVE)
  starsTxId String?
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([userId, status])
}

enum SubscriptionPlan {
  BASIC
  PREMIUM
  VIP
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(cuid())
  telegramId    BigInt
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  starsAmount   Int
  manaAmount    Int      @default(0)
  itemType      String   // "mana_pack", "subscription", "reading"
  itemId        String?
  telegramPayId String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@index([telegramId])
}

// ─── Referrals ───────────────────────────────────────────────────────────────

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation("referrer", fields: [referrerId], references: [id])
  referredId  String   @unique
  referred    User     @relation("referred", fields: [referredId], references: [id])
  bonusGiven  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─── Card Collection ─────────────────────────────────────────────────────────

model CardCollection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  cardId    Int
  unlockedAt DateTime @default(now())

  @@unique([userId, cardId])
  @@index([userId])
}
